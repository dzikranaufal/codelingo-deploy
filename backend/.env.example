# Salin file ini menjadi .env, lalu isi nilainya. JANGAN commit file .env.

# --- Database (PostgreSQL / Supabase) ---
# Opsi A (disarankan): connection string lengkap.
# Supabase: Dashboard > Connect > "Session pooler" (port 5432, jaringan IPv4).
# Jika password mengandung karakter khusus (@ : / # ?), ubah jadi %-encoding.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Opsi B: kosongkan DATABASE_URL, lalu isi bagian ini (contoh PostgreSQL lokal).
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=codelingo
# DB_SSLMODE=disable

# Pengaturan koneksi (opsional, nilai di bawah adalah default)
# DB_MAX_OPEN_CONNS=5
# DB_MAX_IDLE_CONNS=2
# DB_CONN_MAX_LIFETIME_MINUTES=30
# Isi true HANYA jika memakai Transaction pooler (port 6543)
# DB_SIMPLE_PROTOCOL=false

# Zona waktu aplikasi: batas hari/pekan untuk misi, quest, streak, leaderboard.
# Semua developer harus memakai nilai yang sama.
APP_TIMEZONE=Asia/Jakarta

SERVER_PORT=8080

# Minimal 32 karakter acak. Contoh membuatnya di PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
